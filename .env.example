# HTTP port for the detection API.
PORT=3000

# Capture a new frame once per minute.
CAPTURE_INTERVAL_SECONDS=60

# Required camera source. For a page with a <video>, set all four values:
CAMERA_URL=http://live.uci.agh.edu.pl/video/stream1.shtml
CAMERA_MEDIA_TYPE=video
CAMERA_SELECTOR=video
CAMERA_READY_SELECTOR=video

# `page`, `image`, and `video` are supported. For a page, CAMERA_SELECTOR is the
# element to screenshot; for image/video it must select the media element.
# CAMERA_TIMEOUT_MS=20000
# VIEWPORT_WIDTH=1280
# VIEWPORT_HEIGHT=720

# Override the marked parking polygons if the camera angle changes. Coordinates are
# normalized [x, y] values from 0 to 1; ids must be lowercase letters/numbers/hyphens.
# CAMERA_AREAS_JSON=[{"id":"north-row","points":[[0.1,0.1],[0.3,0.1],[0.3,0.3],[0.1,0.3]],"capacity":4}]
